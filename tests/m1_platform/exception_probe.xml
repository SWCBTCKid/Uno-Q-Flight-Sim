<?xml version="1.0"?>
<!-- M1-001 Platform pipeline check: the first event sets a property that does
     not exist, so FGScript throws a LogException (std::runtime_error) inside
     libJSBSim.so on the first step. The shim must catch it as std::exception
     and keep its text (one C++ runtime in the process). -->
<runscript name="gx exception probe">
  <use aircraft="c172p" initialize="reset00"/>
  <run start="0.0" end="1.0" dt="0.0083333333333333">
    <event name="set an undefined property">
      <condition>simulation/sim-time-sec ge 0.0</condition>
      <set name="gx/no-such-property" value="1.0"/>
    </event>
  </run>
</runscript>
