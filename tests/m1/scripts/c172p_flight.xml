      </condition>
      <set name="gx/hdg-err"><function><difference><mod><sum><difference><p>gx/hdg-tgt</p><p>attitude/psi-deg</p></difference><v>540.0</v></sum><v>360.0</v></mod><v>180.0</v></difference></function></set>
    </event>

    <event name="parked">
      <condition logic="AND">
        simulation/sim-time-sec ge 0.0
      </condition>
      <set name="gx/seg" value="1"/>
      <set name="fcs/left-brake-cmd-norm" value="1"/>
      <set name="fcs/right-brake-cmd-norm" value="1"/>
      <set name="fcs/center-brake-cmd-norm" value="1"/>
      <set name="fcs/throttle-cmd-norm[0]" value="0.0"/>
      <set name="fcs/flap-cmd-norm" value="0"/>
      <set name="gear/gear-cmd-norm" value="1"/>
