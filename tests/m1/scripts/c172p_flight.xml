      <set name="gx/theta-cmd"><function><min><v>6.0</v><sum><p>gx/theta-cmd</p><product><v>3.0</v><p>simulation/dt</p></product></sum></min></function></set>
    </event>

    <event name="gx:hdot-pitch" continuous="true">
      <condition logic="AND">
