      <set name="fcs/aileron-cmd-norm" value="0"/>
      <set name="fcs/rudder-cmd-norm" value="0"/>
      <set name="fcs/steer-cmd-norm" value="0"/>
      <set name="fcs/mixture-cmd-norm" value="1"/>
    </event>

    <event name="taxi">
      <condition logic="AND">
        simulation/sim-time-sec ge 12.0
      </condition>
      <set name="gx/seg" value="2"/>
      <set name="fcs/left-brake-cmd-norm" value="0"/>
      <set name="fcs/right-brake-cmd-norm" value="0"/>
      <set name="fcs/center-brake-cmd-norm" value="0"/>
      <set name="gx/vt" value="10.0"/>
    </event>

    <event name="gx:taxi-speed" continuous="true">
      <condition logic="AND">
        gx/seg eq 2
      </condition>
      <set name="gx/thr-int"><function><min><v>0.5</v><max><v>0.0</v><sum><p>gx/thr-int</p><product><v>0.03</v><difference><p>gx/vt</p><product><p>velocities/vg-fps</p><v>0.5924838012958963</v></product></difference><p>simulation/dt</p></product></sum></max></min></function></set>
      <set name="fcs/throttle-cmd-norm[0]"><function><p>gx/thr-int</p></function></set>
      <set name="fcs/left-brake-cmd-norm"><function><min><v>1.0</v><max><v>0.0</v><product><v>0.05</v><difference><product><p>velocities/vg-fps</p><v>0.5924838012958963</v></product><sum><p>gx/vt</p><v>2.0</v></sum></difference></product></max></min></function></set>
      <set name="fcs/right-brake-cmd-norm"><function><min><v>1.0</v><max><v>0.0</v><product><v>0.05</v><difference><product><p>velocities/vg-fps</p><v>0.5924838012958963</v></product><sum><p>gx/vt</p><v>2.0</v></sum></difference></product></max></min></function></set>
    </event>

    <event name="gx:steer-takeoff" continuous="true">
      <condition logic="AND">
        gx/seg ge 2
        gx/seg le 4
      </condition>
      <set name="fcs/steer-cmd-norm"><function><min><v>1.0</v><max><v>-1.0</v><product><v>0.1</v><p>gx/hdg-err</p></product></max></min></function></set>
      <set name="fcs/rudder-cmd-norm"><function><min><v>1.0</v><max><v>-1.0</v><difference><product><v>0.02</v><product><p>velocities/r-rad_sec</p><v>57.29577951308232</v></product></product><product><v>0.05</v><p>gx/hdg-err</p></product></difference></max></min></function></set>
    </event>

    <event name="gx:steer-rollout" continuous="true">
      <condition logic="AND">
        gx/seg ge 8
        gx/seg le 9
      </condition>
      <set name="fcs/steer-cmd-norm"><function><min><v>1.0</v><max><v>-1.0</v><product><v>0.1</v><p>gx/hdg-err</p></product></max></min></function></set>
      <set name="fcs/rudder-cmd-norm"><function><min><v>1.0</v><max><v>-1.0</v><difference><product><v>0.02</v><product><p>velocities/r-rad_sec</p><v>57.29577951308232</v></product></product><product><v>0.05</v><p>gx/hdg-err</p></product></difference></max></min></function></set>
    </event>

    <event name="takeoff_roll">
      <condition logic="AND">
        simulation/sim-time-sec ge 52.0
      </condition>
      <set name="gx/seg" value="3"/>
      <set name="fcs/left-brake-cmd-norm" value="0"/>
      <set name="fcs/right-brake-cmd-norm" value="0"/>
      <set name="fcs/center-brake-cmd-norm" value="0"/>
      <set name="fcs/flap-cmd-norm" value="0.0"/>
      <set name="fcs/throttle-cmd-norm[0]" value="1.0" action="FG_RAMP" tc="3.0"/>
      <set name="fcs/elevator-cmd-norm" value="0"/>
    </event>

