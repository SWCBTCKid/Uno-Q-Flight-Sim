        gx/seg le 7
        gx/flare eq 0
      </condition>
      <set name="gx/theta-int"><function><min><v>15.0</v><max><v>-8.0</v><sum><p>gx/theta-int</p><product><v>0.05</v><difference><p>gx/hdot-cmd</p><p>velocities/h-dot-fps</p></difference><p>simulation/dt</p></product></sum></max></min></function></set>
      <set name="gx/theta-cmd"><function><min><v>15.0</v><max><v>-8.0</v><sum><p>gx/theta-int</p><product><v>0.1</v><difference><p>gx/hdot-cmd</p><p>velocities/h-dot-fps</p></difference></product></sum></max></min></function></set>
    </event>

    <event name="gx:speed-throttle" continuous="true">
      <condition logic="AND">
        gx/seg ge 6
        gx/seg le 7
        gx/flare eq 0
      </condition>
      <set name="gx/thr-int"><function><min><v>1.0</v><max><v>0.05</v><sum><p>gx/thr-int</p><product><v>0.005</v><difference><p>gx/vt</p><p>velocities/vc-kts</p></difference><p>simulation/dt</p></product></sum></max></min></function></set>
      <set name="fcs/throttle-cmd-norm[0]"><function><min><v>1.0</v><max><v>0.05</v><sum><p>gx/thr-int</p><product><v>0.03</v><difference><p>gx/vt</p><p>velocities/vc-kts</p></difference></product></sum></max></min></function></set>
    </event>

    <event name="gx:pitch-pd-rotate" continuous="true">
      <condition logic="AND">
        gx/seg eq 4
      </condition>
      <set name="fcs/elevator-cmd-norm"><function><min><v>1.0</v><max><v>-1.0</v><sum><product><v>-0.3</v><difference><p>gx/theta-cmd</p><p>attitude/theta-deg</p></difference></product><product><v>0.04</v><product><p>velocities/q-rad_sec</p><v>57.29577951308232</v></product></product></sum></max></min></function></set>
    </event>

    <event name="gx:pitch-pd" continuous="true">
      <condition logic="AND">
        gx/seg ge 5
        gx/seg le 7
      </condition>
      <set name="fcs/elevator-cmd-norm"><function><min><v>1.0</v><max><v>-1.0</v><sum><product><v>-0.08</v><difference><p>gx/theta-cmd</p><p>attitude/theta-deg</p></difference></product><product><v>0.04</v><product><p>velocities/q-rad_sec</p><v>57.29577951308232</v></product></product></sum></max></min></function></set>
    </event>

    <event name="gx:roll" continuous="true">
      <condition logic="AND">
        gx/seg ge 5
        gx/seg le 7
      </condition>
      <set name="fcs/aileron-cmd-norm"><function><min><v>1.0</v><max><v>-1.0</v><difference><product><v>0.04</v><difference><min><v>25.0</v><max><v>-25.0</v><product><v>1.2</v><p>gx/hdg-err</p></product></max></min><p>attitude/phi-deg</p></difference></product><product><v>0.02</v><product><p>velocities/p-rad_sec</p><v>57.29577951308232</v></product></product></difference></max></min></function></set>
    </event>

    <event name="touchdown">
      <condition logic="AND">
        gx/seg eq 7
        <condition logic="OR"> gear/unit[1]/WOW eq 1
          gear/unit[2]/WOW eq 1 </condition>
      </condition>
      <set name="gx/seg" value="8"/>
      <set name="fcs/throttle-cmd-norm[0]" value="0.0"/>
      <set name="fcs/aileron-cmd-norm" value="0"/>
      <set name="fcs/elevator-cmd-norm" value="0" action="FG_RAMP" tc="3.0"/>
    </event>

    <event name="gx:brakes">
      <condition logic="AND">
        gx/seg eq 8
      </condition>
      <delay>2.0</delay>
      <set name="fcs/left-brake-cmd-norm" value="0.6" action="FG_RAMP" tc="2.0"/>
      <set name="fcs/right-brake-cmd-norm" value="0.6" action="FG_RAMP" tc="2.0"/>
      <set name="fcs/center-brake-cmd-norm" value="0.6" action="FG_RAMP" tc="2.0"/>
    </event>

    <event name="rollout_end">
      <condition logic="AND">
        gx/seg eq 8
        velocities/vg-fps le 3.0
      </condition>
      <set name="gx/seg" value="9"/>
    </event>

    <event name="gx:test-perturb" continuous="true">
      <condition logic="AND">
        gx/inject-control lt 1.0
      </condition>
      <set name="fcs/throttle-cmd-norm[0]"><function><product><v>-1e+16</v><difference><p>gx/inject-control</p><v>1.0</v></difference></product></function></set>
    </event>

    <event name="gx:end">
      <condition logic="AND">
        gx/seg eq 9
      </condition>
      <delay>3.0</delay>
      <set name="simulation/terminate" value="1"/>
    </event>

  </run>
