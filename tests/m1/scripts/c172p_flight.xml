    </event>

    <event name="gx:hdg-centreline" continuous="true">
      <condition logic="AND">
        gx/leg eq 0
      </condition>
      <set name="gx/hdg-tgt"><function><sum><v>90.0</v><min><v>20.0</v><max><v>-20.0</v><product><v>0.1</v><p>gx/y-m</p></product></max></min></sum></function></set>
    </event>

    <event name="gx:hdg-final" continuous="true">
      <condition logic="AND">
        gx/leg eq 4
      </condition>
      <set name="gx/hdg-tgt"><function><sum><v>90.0</v><min><v>20.0</v><max><v>-20.0</v><product><v>0.1</v><p>gx/y-m</p></product></max></min></sum></function></set>
    </event>

    <event name="gx:hdg-err" continuous="true">
