    </event>

    <event name="gx:downwind">
      <condition logic="AND">
        gx/leg eq 1
        gx/y-m ge 1500.0
      </condition>
      <set name="gx/leg" value="2"/>
      <set name="gx/hdg-tgt" value="270.0"/>
