  <use aircraft="c172p" initialize="gx_m1_ic_override_required"/>

  <run start="0.0" end="1500.0" dt="0.0083333333333333333">
    <property value="0"> gx/seg </property>
    <property value="0"> gx/leg </property>
    <property value="0"> gx/x-m </property>
    <property value="0"> gx/y-m </property>
