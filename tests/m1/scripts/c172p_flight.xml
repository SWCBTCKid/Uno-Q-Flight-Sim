        velocities/vc-kts ge 55.0
      </condition>
      <set name="gx/seg" value="4"/>
      <set name="gx/theta-int"><function><p>attitude/theta-deg</p></function></set>
    </event>

    <event name="gx:rotate-ramp" continuous="true">
      <condition logic="AND">
        gx/seg eq 4
      </condition>
      <set name="gx/theta-int"><function><min><v>8.0</v><max><v>-90.0</v><sum><p>gx/theta-int</p><product><v>3.0</v><p>simulation/dt</p></product></sum></max></min></function></set>
      <set name="gx/theta-cmd"><function><p>gx/theta-int</p></function></set>
    </event>

    <event name="liftoff">
      <condition logic="AND">
        gx/seg eq 4
        gear/unit[0]/WOW eq 0
        gear/unit[1]/WOW eq 0
        gear/unit[2]/WOW eq 0
      </condition>
      <set name="gx/seg" value="5"/>
      <set name="fcs/steer-cmd-norm" value="0"/>
      <set name="fcs/rudder-cmd-norm" value="0"/>
    </event>

    <event name="gx:flaps-up">
      <condition logic="AND">
        gx/seg ge 5
        position/h-agl-ft ge 300.0
      </condition>
      <set name="fcs/flap-cmd-norm" value="0"/>
    </event>

    <event name="gx:climb-pitch" continuous="true">
      <condition logic="AND">
        gx/seg eq 5
      </condition>
      <set name="gx/theta-int"><function><min><v>15.0</v><max><v>-8.0</v><sum><p>gx/theta-int</p><product><v>0.05</v><difference><p>velocities/vc-kts</p><v>75.0</v></difference><p>simulation/dt</p></product></sum></max></min></function></set>
      <set name="gx/theta-cmd"><function><min><v>15.0</v><max><v>-8.0</v><sum><p>gx/theta-int</p><product><v>0.3</v><difference><p>velocities/vc-kts</p><v>75.0</v></difference></product></sum></max></min></function></set>
