    <event name="gx:downwind-config">
      <condition logic="AND">
        gx/leg eq 2
        gx/x-m le -1000.0
      </condition>
      <set name="gear/gear-cmd-norm" value="1"/>
      <set name="fcs/flap-cmd-norm" value="0.0"/>
      <set name="gx/vt" value="85.0"/>
    </event>

    <event name="gx:base">
      <condition logic="AND">
        gx/leg eq 2
        gx/x-m le -4000.0
      </condition>
      <set name="gx/leg" value="3"/>
      <set name="gx/hdg-tgt" value="180.0"/>
    </event>

    <event name="final">
      <condition logic="AND">
        gx/leg eq 3
        gx/y-m le 600.0
      </condition>
      <set name="gx/seg" value="7"/>
      <set name="gx/leg" value="4"/>
      <set name="fcs/flap-cmd-norm" value="0.66"/>
      <set name="gx/vt" value="65.0"/>
    </event>

    <event name="gx:alt-hold" continuous="true">
      <condition logic="AND">
